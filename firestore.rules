// Firestore security rules — Atelier Achi booking system.
// Publish in: Firebase console → Firestore Database → Rules (paste + Publish).
// Tested with the emulator: `npm run test:rules` (see tests/).
//
// Data model
//   bookings/{id}  Customer details (name, email, phone…). ADMIN ONLY to read.
//   slots/{id}     Public availability: { date, time, dur } — no personal data.
//                  Same id as its booking; created together in one batch.
//   settings/config  { blockToday } — public read, admin write.
//   customers/{id} Customer cards (visit counts, dates, services) — ADMIN ONLY.
//   stats/{YYYY-MM} Anonymous monthly statistics — ADMIN ONLY.
//   admins/{uid}   One empty document per admin account (created by hand in
//                  the console). The website can never write here.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function str(v, max) { return v is string && v.size() <= max; }
    function nonEmpty(v, max) { return str(v, max) && v.size() > 0; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isTime(v) { return v is string && v.matches('^[0-9]{2}:[0-9]{2}$'); }
    function isDur(v)  { return v is int && v > 0 && v <= 240; }

    // Not more than a day in the past (slack for time zones).
    function notPast(ds) {
      let p = ds.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) > request.time - duration.value(2, 'd');
    }

    function validBooking(d) {
      return d.keys().hasOnly(['first', 'last', 'email', 'phone', 'service', 'dur', 'price',
                               'date', 'time', 'msg', 'status', 'source', 'createdAt'])
        && d.keys().hasAll(['first', 'last', 'email', 'phone', 'service', 'dur', 'price',
                            'date', 'time', 'msg', 'status', 'source', 'createdAt'])
        && nonEmpty(d.first, 60) && nonEmpty(d.last, 60)
        && str(d.email, 120) && str(d.phone, 20) && str(d.msg, 300)
        && nonEmpty(d['service'], 120) && str(d.price, 20) && isDur(d.dur)   // 'service' is a reserved word
        && isDate(d.date) && isTime(d.time)
        && d.status == 'confirmed'
        && d.source in ['website', 'admin']
        && d.createdAt == request.time;
    }

    function validSlot(s) {
      return s.keys().hasOnly(['date', 'time', 'dur'])
        && s.keys().hasAll(['date', 'time', 'dur'])
        && isDate(s.date) && isTime(s.time) && isDur(s.dur);
    }

    function bookingPath(id) { return /databases/$(database)/documents/bookings/$(id); }
    function slotPath(id)    { return /databases/$(database)/documents/slots/$(id); }

    match /bookings/{id} {
      allow read, update, delete: if isAdmin();
      // Public: website bookings only, for today or later, valid email,
      // and the matching public slot must be created in the same batch.
      allow create: if validBooking(request.resource.data)
        && existsAfter(slotPath(id))
        && (isAdmin()
            || (request.resource.data.source == 'website'
                && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                && notPast(request.resource.data.date)));
    }

    match /slots/{id} {
      allow read: if true;
      allow update, delete: if isAdmin();
      // A slot must mirror a booking with the same id (written in the same batch).
      allow create: if validSlot(request.resource.data)
        && (isAdmin()
            || (existsAfter(bookingPath(id))
                && getAfter(bookingPath(id)).data.date == request.resource.data.date
                && getAfter(bookingPath(id)).data.time == request.resource.data.time
                && getAfter(bookingPath(id)).data.dur == request.resource.data.dur));
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer cards (visit counts, contact details) — admin only.
    match /customers/{id} {
      allow read, write: if isAdmin();
    }

    // Anonymous monthly statistics — admin only.
    match /stats/{month} {
      allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
